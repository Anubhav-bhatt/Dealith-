# Synthetic local credentials only. Never use these in shared/live environments.
APP_ENV=local
DATABASE_URL=postgresql://dealith_app:dealith_app_local@127.0.0.1:54329/dealith
MIGRATION_DATABASE_URL=postgresql://dealith_migrator:dealith_migrator_local@127.0.0.1:54329/dealith
REDIS_URL=redis://127.0.0.1:56379
API_HOST=127.0.0.1
API_PORT=4000
WORKER_HOST=127.0.0.1
WORKER_PORT=4001
API_INTERNAL_ORIGIN=http://127.0.0.1:4000
WEB_ORIGIN=http://localhost:3000
ADMIN_ORIGIN=http://localhost:3001
# Optional: http://127.0.0.1:4318/v1/traces
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=

WORKER_INTERNAL_ORIGIN=http://127.0.0.1:4001
WEB_PORT=3000
ADMIN_PORT=3001
NODE_ENV=development
LOG_LEVEL=info
APP_VERSION=0.1.0
# Optional deployed commit SHA; never inferred from an uncommitted working tree.
COMMIT_SHA=
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_METRICS_ENDPOINT=
# Defaults to the exact web/admin origins if omitted; never a wildcard.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

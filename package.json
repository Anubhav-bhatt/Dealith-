{
  "name": "dealith",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.24.0",
  "engines": {
    "node": ">=24.19.0 <25",
    "pnpm": "11.24.0"
  },
  "scripts": {
    "docs:check": "python3 tools/validate_phase0.py",
    "docs:test": "PYTHONDONTWRITEBYTECODE=1 python3 -m unittest discover -s tools -p 'test_validate_phase0.py'",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . && node tools/check-boundaries.mjs",
    "typecheck": "pnpm -r --workspace-concurrency=1 typecheck && tsc -p tests/tsconfig.json --noEmit",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:status": "prisma migrate status",
    "build:packages": "pnpm --filter \"./packages/**\" --workspace-concurrency=1 build",
    "build": "pnpm db:generate && pnpm -r --workspace-concurrency=1 build",
    "dev": "node --env-file-if-exists=.env tools/dev.mjs",
    "dev:api": "node --env-file-if-exists=.env --import tsx --watch apps/api/src/main.ts",
    "dev:worker": "node --env-file-if-exists=.env --import tsx --watch apps/worker/src/main.ts",
    "dev:web": "node tools/start-dev-next.mjs web",
    "dev:admin": "node tools/start-dev-next.mjs admin",
    "start:api": "node --env-file-if-exists=.env apps/api/dist/main.js",
    "start:worker": "node --env-file-if-exists=.env apps/worker/dist/main.js",
    "start:web": "node tools/start-next.mjs web",
    "start:admin": "node tools/start-next.mjs admin",
    "test:unit": "vitest run --project unit",
    "test:tooling": "node --test tools/test-dev.mjs",
    "test:component": "vitest run --project component",
    "test:contract": "vitest run --project contract",
    "test:integration": "node --env-file-if-exists=.env tools/integration.mjs",
    "test:e2e": "playwright test",
    "test": "pnpm test:tooling && pnpm test:unit && pnpm test:component && pnpm test:contract && pnpm test:integration",
    "check": "pnpm docs:check && pnpm docs:test && pnpm security:scan && pnpm format:check && pnpm build && pnpm contracts:check && pnpm lint && pnpm typecheck && pnpm test && pnpm test:e2e && pnpm test:smoke",
    "dev:local": "node tools/local.mjs",
    "test:smoke": "node tools/smoke.mjs",
    "contracts:generate": "node tools/export-contracts.mjs",
    "contracts:check": "node tools/export-contracts.mjs --check",
    "check:ci": "pnpm docs:check && pnpm docs:test && pnpm security:scan && pnpm format:check && pnpm build && pnpm contracts:check && pnpm lint && pnpm typecheck && pnpm test && pnpm test:e2e",
    "verify": "pnpm check",
    "test:api": "pnpm test:contract",
    "infra:up": "node tools/infra.mjs up",
    "infra:down": "node tools/infra.mjs down",
    "test:benchmark": "node tools/benchmark.mjs",
    "test:clean-install": "node tools/clean-install.mjs",
    "security:scan": "node tools/secret-scan.mjs"
  },
  "devDependencies": {
    "typescript": "6.0.3",
    "tsx": "4.23.13",
    "vitest": "4.1.11",
    "eslint": "10.10.0",
    "@eslint/js": "10.0.1",
    "typescript-eslint": "8.69.0",
    "eslint-config-prettier": "10.1.8",
    "prettier": "3.9.6",
    "@types/node": "24.13.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@types/pg": "8.23.1",
    "@types/express": "5.0.6",
    "@types/supertest": "7.2.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "7.0.1",
    "jsdom": "30.0.1",
    "supertest": "7.2.2",
    "@playwright/test": "1.63.0",
    "prisma": "7.10.0",
    "@nestjs/testing": "12.0.1",
    "bullmq": "6.3.4",
    "@dealith/test-kit": "workspace:*",
    "@axe-core/playwright": "4.13.0"
  },
  "dependencies": {
    "@dealith/backend": "workspace:*",
    "@dealith/config": "workspace:*",
    "@dealith/contracts": "workspace:*",
    "@dealith/events": "workspace:*",
    "@dealith/security": "workspace:*",
    "@dealith/observability": "workspace:*",
    "@dealith/ui": "workspace:*",
    "@prisma/client": "7.10.0",
    "@prisma/adapter-pg": "7.10.0",
    "pg": "8.23.0",
    "zod": "4.5.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "@nestjs/core": "12.0.1",
    "@nestjs/common": "12.0.1",
    "@nestjs/platform-express": "12.0.1",
    "reflect-metadata": "0.2.2"
  }
}
